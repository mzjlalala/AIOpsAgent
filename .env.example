# Application
APP_NAME=OpsAgent
APP_ENV=dev
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# Database (async runtime)
DATABASE_URL=mysql+asyncmy://opsagent:opsagent@127.0.0.1:3306/opsagent
