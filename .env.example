# Application
APP_NAME=OpsAgent
APP_ENV=dev
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# Database (async runtime)
DATABASE_URL=mysql+asyncmy://opsagent:opsagent@127.0.0.1:3306/opsagent
# Optional sync URL for Alembic; if omitted, derived from DATABASE_URL
# DATABASE_URL_SYNC=mysql+pymysql://opsagent:opsagent@127.0.0.1:3306/opsagent
DATABASE_ECHO=false

# LLM（OpenAI 兼容；默认 mock）
LLM_PROVIDER=mock
# LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
LLM_TIMEOUT_SECONDS=60
